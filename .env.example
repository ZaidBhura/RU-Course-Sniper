# RU Course Sniper — environment variables
# Copy to .env and fill in real values. Never commit .env to version control.
#
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate FERNET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ──────────────────────────────────────────────
# Database (required)
# ──────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# docker compose sets this automatically via the environment: block
DATABASE_URL=postgresql+asyncpg://sniper:sniper_dev@localhost:5432/course_sniper

# Used by docker-compose.yml for the postgres service password
POSTGRES_PASSWORD=sniper_dev

# ──────────────────────────────────────────────
# Redis (required)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# Security (required)
# ──────────────────────────────────────────────
# 32-byte hex random string for JWT signing and general signing
SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# 44-char URL-safe base64 Fernet key for encrypting notification channel credentials
# IMPORTANT: Losing this key means all stored Discord webhook URLs / Pushover tokens
# become permanently unreadable. Back it up securely.
FERNET_KEY=change_me_generate_with_fernet_generate_key

# ──────────────────────────────────────────────
# Application (optional — defaults shown)
# ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sentry DSN for error tracking (leave blank to disable)
# SENTRY_DSN=

# ──────────────────────────────────────────────
# Legacy CLI (original config — still used by legacy/ during migration)
# ──────────────────────────────────────────────
# Discord webhook URL for the legacy CLI notifier
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Pushover notifications (optional, legacy CLI only)
# PUSHOVER_TOKEN=your_pushover_token
# PUSHOVER_USER=your_pushover_user
